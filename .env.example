# Copie para .env.local (fora do git) e preencha. Este arquivo vai para o git: não coloque valores reais.

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://tucuxsavicgkzrbtravx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Rj5o1-RdujY6OXpxgd-u8g_1gkYFdEz
# Chave SECRETA (sb_secret_... ou service_role). Só para migrações e carga inicial.
# NUNCA no navegador. Em execução, só a tela Equipe (criar e remover logins, só para admin) a usa, no servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Senha única das contas humanas de demonstração (mínimo 6 caracteres)
DEMO_SENHA=
ADMIN_EMAIL=admin.simulacao@example.com

# Contas dos agentes (só no servidor)
AGENTE_OPERACAO_EMAIL=agente.operacao@example.com
AGENTE_OPERACAO_SENHA=
AGENTE_VALIDACAO_EMAIL=agente.validacao@example.com
AGENTE_VALIDACAO_SENHA=
AGENTE_LEITOR_EMAIL=agente.leitor@example.com
AGENTE_LEITOR_SENHA=
# Gerador de eventos da simulação (migração 9). Opcional: sem a conta, a simulação roda só com a base de CSV.
AGENTE_GERADOR_EMAIL=agente.gerador@example.com
AGENTE_GERADOR_SENHA=
# Desliga o gerador (GOAUDIT_GERADOR=desligado) ou ajusta o volume (GOAUDIT_GERADOR_INTENSIDADE=baixa|media|alta; padrão baixa)
# GOAUDIT_GERADOR=desligado
# GOAUDIT_GERADOR_INTENSIDADE=baixa

# AI Proxy do Gogroup (só no servidor)
AI_PROXY_API_KEY=

# Opcional: outra pasta de base de entrada (padrão: data/demo)
# GOAUDIT_BASE_DIR=data/demo
